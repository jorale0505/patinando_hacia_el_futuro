---
// Footer component for Patinando Hacia El Futuro con degradado completo institucional (Rojo, Naranja, Amarillo, Verde)
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Barra de Acento Superior con el Degradado Completo -->
  <div class="footer-top-accent"></div>

  <div class="footer-container">
    <div class="footer-grid">
      <!-- Col 1: Presentación de Marca -->
      <div class="footer-brand-col">
        <a href="#inicio" class="footer-brand" aria-label="Ir al inicio">
          <img
            src={`${import.meta.env.BASE_URL}images/logo.png`}
            alt="Logo Oficial Patinando Hacia El Futuro"
            class="footer-logo"
            width="58"
            height="58"
          />
          <div class="footer-brand-text">
            <span class="brand-title font-sports">PATINANDO</span>
            <span class="brand-sub">HACIA EL FUTURO</span>
          </div>
        </a>

        <p class="footer-slogan">
          "Desliza tus sueños hacia el futuro."
        </p>

        <p class="footer-bio">
          Formamos disciplina, constancia y carácter deportivo en niños, niñas y jóvenes a través del patinaje de carreras y la alta competencia.
        </p>

        <!-- Indicador de colores institucionales en barra sutil -->
        <div class="brand-colors-bar">
          <span class="bar-color color-red"></span>
          <span class="bar-color color-orange"></span>
          <span class="bar-color color-yellow"></span>
          <span class="bar-color color-green"></span>
        </div>
      </div>

      <!-- Col 2: Enlaces de Navegación a Todas las Secciones -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Secciones</h4>
        <ul class="footer-links">
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#nuestra-escuela">Nuestra Escuela</a></li>
          <li><a href="#profes">Nuestros Profes</a></li>
          <li><a href="#comunidad">Nuestra Comunidad</a></li>
          <li><a href="#victorias">Nuestras Victorias</a></li>
          <li><a href="#competencias">Próximas Competencias</a></li>
          <li><a href="#noticias">Noticias & Comunicados</a></li>
        </ul>
      </div>

      <!-- Col 3: Niveles y Escuela Deportiva -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Escuela Deportiva</h4>
        <ul class="footer-links">
          <li><span>Semilleros (2 a 6 años)</span></li>
          <li><span>Escuela de Formación</span></li>
          <li><span>Menores & Transición</span></li>
          <li><span>Prejuvenil & Velocidad</span></li>
          <li><span>Ruta y Alta Competencia</span></li>
          <li><span>Caimalito & La Virginia</span></li>
        </ul>
      </div>

      <!-- Col 4: Contacto & Canal Oficial -->
      <div class="footer-contact-col">
        <h4 class="footer-col-title">Contacto Directo</h4>
        <p class="contact-item">
          <span class="contact-icon">📍</span>
          <span>Pista de La Virginia & Caimalito · Pereira</span>
        </p>
        <p class="contact-item">
          <span class="contact-icon">📱</span>
          <span>WhatsApp Oficial: (+57) 300 000 0000</span>
        </p>
        <p class="contact-item">
          <span class="contact-icon">🕒</span>
          <span>Horarios: Martes a Sábado (Jornadas Tarde y Mañana)</span>
        </p>

        <a
          href="https://wa.me/573000000000?text=Hola%2C%20quiero%20inscribirme%20en%20Patinando%20Hacia%20El%20Futuro"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-footer-wa"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.969.541 1.838.835 2.796.835 3.18 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.767-5.768-5.767zm7.545 5.766c-.002 4.159-3.385 7.542-7.545 7.542-1.282 0-2.529-.328-3.633-.948l-4.398 1.153 1.173-4.288c-.689-1.159-1.054-2.483-1.054-3.847.002-4.159 3.385-7.542 7.545-7.542 4.159.001 7.542 3.384 7.542 7.542z"/>
          </svg>
          <span>Escribir por WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Pie Inferior con Lema en Degradado Completo -->
    <div class="footer-bottom">
      <p>© {currentYear} Patinando Hacia El Futuro. Todos los derechos reservados.</p>
      <div class="footer-legal">
        <span class="footer-legal-motto">Disciplina · Pasión · Constancia · Futuro</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    background-color: #000000;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: clamp(60px, 7vw, 90px);
    padding-bottom: 35px;
    overflow: hidden;
  }

  /* Barra Superior con Degradado Completo Neón */
  .footer-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #E51B23 0%, #F57C00 32%, #FFD21F 68%, #009B55 100%);
    box-shadow: 0 0 20px rgba(245, 124, 0, 0.5), 0 0 35px rgba(0, 155, 85, 0.3);
  }

  .footer-container {
    width: 100%;
    max-width: min(94vw, 1720px);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 6rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 1fr 1.2fr;
    gap: clamp(2rem, 3.5vw, 3.5rem);
    margin-bottom: 4rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.2rem;
    text-decoration: none;
  }

  .footer-logo {
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(245, 124, 0, 0.4));
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 1.55rem;
    letter-spacing: 1.5px;
    color: var(--color-white);
    line-height: 1;
    font-weight: 900;
  }

  .brand-sub {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 2.2px;
    background: linear-gradient(90deg, #E51B23 0%, #F57C00 32%, #FFD21F 68%, #009B55 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .footer-slogan {
    font-size: 1.05rem;
    font-weight: 700;
    font-style: italic;
    color: var(--color-yellow-future);
    margin: 0 0 0.85rem;
  }

  .footer-bio {
    font-size: 0.88rem;
    color: var(--color-gray-tech);
    line-height: 1.6;
    max-width: 330px;
    margin: 0 0 1.2rem;
  }

  /* Mini barra institucional de colores */
  .brand-colors-bar {
    display: flex;
    gap: 6px;
    margin-top: 0.5rem;
  }

  .bar-color {
    width: 24px;
    height: 4px;
    border-radius: 2px;
  }

  .color-red { background: #E51B23; box-shadow: 0 0 8px rgba(229, 27, 35, 0.5); }
  .color-orange { background: #F57C00; box-shadow: 0 0 8px rgba(245, 124, 0, 0.5); }
  .color-yellow { background: #FFD21F; box-shadow: 0 0 8px rgba(255, 210, 31, 0.5); }
  .color-green { background: #009B55; box-shadow: 0 0 8px rgba(0, 155, 85, 0.5); }

  .footer-col-title {
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .footer-links li a,
  .footer-links li span {
    font-size: 0.88rem;
    color: var(--color-gray-muted);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .footer-links li a:hover {
    color: var(--color-yellow-future);
    padding-left: 5px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-gray-tech);
    margin-bottom: 0.85rem;
    line-height: 1.45;
  }

  .contact-icon {
    flex-shrink: 0;
    font-size: 1rem;
  }

  .btn-footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(90deg, #E51B23 0%, #F57C00 32%, #FFD21F 68%, #009B55 100%);
    color: #000000;
    font-weight: 900;
    font-size: 0.88rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-full);
    margin-top: 0.75rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 20px rgba(245, 124, 0, 0.35);
  }

  .btn-footer-wa:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 25px rgba(245, 124, 0, 0.5), 0 0 20px rgba(0, 155, 85, 0.4);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    font-size: 0.84rem;
    color: var(--color-gray-tech);
    margin: 0;
  }

  .footer-legal-motto {
    background: linear-gradient(90deg, #E51B23 0%, #F57C00 32%, #FFD21F 68%, #009B55 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    font-size: 0.88rem;
    letter-spacing: 0.5px;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

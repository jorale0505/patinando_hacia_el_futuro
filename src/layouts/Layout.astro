---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Patinando Hacia El Futuro · Escuela Oficial de Patinaje de Carreras",
  description = "Patina, compite y cumple tus sueños. Escuela de patinaje de velocidad Patinando Hacia El Futuro. Formación integral, alta competencia y valores deportivos."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${base}/images/logo.png`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/images/hero.jpeg`} />

    <!-- Google Fonts: Montserrat & Bebas Neue -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-wrapper">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --color-red-energy: #E51B23;
    --color-orange-speed: #F57C00;
    --color-yellow-future: #FFD21F;
    --color-green-panther: #009B55;
    --color-dark-bg: #000000;
    --color-dark-surface: #0A0A0A;
    --color-dark-card: #111317;
    --color-dark-border: rgba(255, 255, 255, 0.08);
    --color-white: #FFFFFF;
    --color-gray-tech: #A7A9AC;
    --color-gray-muted: #9CA3AF;

    --gradient-energy: linear-gradient(135deg, #E51B23 0%, #F57C00 50%, #FFD21F 100%);
    --gradient-sports: linear-gradient(135deg, #E51B23 0%, #FFD21F 100%);
    --gradient-trail: linear-gradient(90deg, transparent 0%, #E51B23 15%, #F57C00 55%, #FFD21F 100%);
    --gradient-growth: linear-gradient(135deg, #009B55 0%, #FFD21F 100%);

    --font-heading: 'Montserrat', sans-serif;
    --font-sports: 'Bebas Neue', sans-serif;
    --font-body: 'Montserrat', sans-serif;

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 22px;
    --radius-full: 9999px;

    --shadow-glow-red: 0 8px 32px rgba(229, 27, 35, 0.35);
    --shadow-glow-yellow: 0 8px 32px rgba(255, 210, 31, 0.3);
    --shadow-glow-green: 0 8px 32px rgba(0, 155, 85, 0.35);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-family: var(--font-body);
    background-color: #000000;
    color: var(--color-white);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    background-color: #000000;
    color: var(--color-white);
    overflow-x: hidden;
  }

  .site-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #000000;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    outline: none;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #000000;
  }
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #E51B23, #F57C00);
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #FFD21F;
  }

  .font-sports {
    font-family: var(--font-sports);
    letter-spacing: 1px;
  }

  .text-gradient-energy {
    background: var(--gradient-energy);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-sports {
    background: var(--gradient-sports);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }
  }
</style>

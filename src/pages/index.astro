---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AboutSchool from '../components/AboutSchool.astro';
import CoachesSection from '../components/CoachesSection.astro';
import SocialHub from '../components/SocialHub.astro';
import MedalROI from '../components/MedalROI.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import NewsSection from '../components/NewsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Patinando Hacia El Futuro · Escuela Oficial de Patinaje de Carreras"
  description="Escuela de Patinaje de Carreras Patinando Hacia El Futuro. Sigue nuestras redes sociales, noticias, próximas competencias y el medallero oficial de victorias."
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <AboutSchool />
    <CoachesSection />
    <SocialHub />
    <MedalROI />
    <UpcomingEvents />
    <NewsSection />
  </main>
  <Footer />
</Layout>

<style>
  main {
    width: 100%;
    position: relative;
  }
</style>
